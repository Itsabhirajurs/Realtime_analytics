# Aviationstack
AVIATIONSTACK_KEY=YOUR_API_KEY_HERE
AVIATIONSTACK_URL=https://api.aviationstack.com/v1/flights
USE_CACHE=true

# Optional weather source
OPENWEATHER_API_KEY=

# Kafka
KAFKA_BROKER=172.17.204.151:9092

# PostgreSQL
POSTGRES_DB=phyphox_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_LOCAL_DATABASE_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API settings
API_TIMEOUT_SECONDS=20
FLIGHT_POLL_SECONDS=60